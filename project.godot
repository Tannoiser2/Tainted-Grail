; Engine configuration file.
config_version=5

[application]

config/name="Tainted Grail"
config/description="Adattamento digitale di Tainted Grail: La Caduta di Avalon (Awaken Realms) in solitario, per uso personale."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4")
config/icon="res://assets/icona.png"
boot_splash/bg_color=Color(0.06, 0.045, 0.035, 1)
boot_splash/image="res://assets/ui/logo.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[autoload]

Dati="*res://scripts/data/dati.gd"
Immagini="*res://scripts/data/immagini.gd"
Modelli="*res://scripts/data/modelli.gd"
Tema="*res://scripts/ui/tema.gd"
Campagna="*res://scripts/core/campagna.gd"
Net="*res://scripts/net/net.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

textures/canvas_textures/default_texture_filter=1
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
